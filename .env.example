# GhostCal configuration. Copy to .env and fill in. NEVER commit a real .env.
# All variables are prefixed GHOSTCAL_ and validated at startup (fail-fast).

GHOSTCAL_ENVIRONMENT=development

# PostgreSQL (async driver). TIMESTAMPTZ everywhere; the engine relies on tstzrange.
GHOSTCAL_DATABASE_URL=postgresql+asyncpg://ghostcal:ghostcal@localhost:5432/ghostcal

# Redis — Celery broker/result backend and availability cache.
GHOSTCAL_REDIS_URL=redis://localhost:6379/0

# Session signing key. Generate: `openssl rand -base64 48`. Min 32 chars.
GHOSTCAL_SECRET_KEY=change-me-generate-a-real-secret-of-32-plus-characters

# Envelope key for encrypting stored secrets/PII at rest. Generate: `openssl rand -base64 48`.
# Use a random key, NOT a memorable passphrase (it is the key, only stretched by SHA-256).
# Min 32 chars. Outside development the app refuses to start while this is a "change-me" placeholder.
GHOSTCAL_TOKEN_ENCRYPTION_KEY=change-me-generate-a-real-key-of-32-plus-characters

# Token lifetimes (seconds) — optional, sensible defaults applied if omitted.
# GHOSTCAL_ACCESS_TOKEN_TTL_SECONDS=900
# GHOSTCAL_REFRESH_TOKEN_TTL_SECONDS=2592000
# GHOSTCAL_EMAIL_VERIFICATION_TTL_SECONDS=86400

# Frontend base URL — used to build links sent by email (e.g. verification).
GHOSTCAL_FRONTEND_BASE_URL=http://localhost:3001

# Browser origins allowed to call the API (JSON list). Defaults to the dev frontend.
# GHOSTCAL_CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Transactional email via Resend. If RESEND_API_KEY is unset, emails are logged, not sent.
# GHOSTCAL_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
GHOSTCAL_EMAIL_FROM=GhostCal <onboarding@resend.dev>

# How often the worker re-syncs connected CalDAV calendars (seconds).
# GHOSTCAL_CALDAV_SYNC_INTERVAL_SECONDS=900

# Booking reminders: scan cadence (seconds) and offsets (minutes before the meeting) to remind at.
# GHOSTCAL_REMINDER_SCAN_INTERVAL_SECONDS=300
# GHOSTCAL_REMINDER_OFFSETS_MINUTES=[1440, 60]

# --- Containers (compose.yaml) ---------------------------------------------------------------
# Used by `podman-compose up` to provision Postgres and the non-privileged app role.
POSTGRES_PASSWORD=change-me-postgres-superuser-password
GHOSTCAL_APP_DB_PASSWORD=change-me-app-role-password
# In containers the DB/Redis hosts are the service names (postgres, redis) — compose sets the
# DATABASE_URL/REDIS_URL accordingly, so you do NOT set GHOSTCAL_DATABASE_URL here for compose.
