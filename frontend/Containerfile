# GhostCal frontend image. Build from the repository root:
#   podman build -t ghostcal-frontend:dev -f frontend/Containerfile frontend
#
# Why a second image rather than one more process on the backend image: app,
# worker and beat share one image because they share one runtime. This one is
# Node, not Python. Putting both interpreters in a single image would double
# its attack surface so that two unrelated processes could keep one tag.
#
# It is nonetheless published into the SAME ghcr package as the backend, under
# a `-frontend`-suffixed tag derived from the same commit. Two packages meant
# two pins that had to move together with nothing enforcing it, and a frontend
# ahead of its API is a silent failure. One package, two tags from one SHA:
# they cannot diverge, and a single Ansible variable describes both — without
# paying the merged-image cost this comment argues against.
#
# Rocky Linux, like the hosts it runs on and like the backend image, not
# Debian. Node is the official build from nodejs.org, pinned by version and
# SHA-256 (the line for each architecture in that release's SHASUMS256.txt):
# Rocky's own nodejs package trails upstream security releases, and this is a
# public-facing server. The Rocky base is pinned by tag and multi-arch index
# digest, like the backend's. Update deliberately.

ARG ROCKY_IMAGE=docker.io/rockylinux/rockylinux:10.2.20260525.0-minimal@sha256:bc5c1e7a2ec7f4bcef1e51c7f0ebb2d43f05409e0108cdd34f693921d0604360
ARG NODE_VERSION=22.23.4
ARG NODE_SHA256_X64=1805bcd35e6815559bd2eb97db438d3fdb0eb3a5e6a977b7c1badca76337e9ce
ARG NODE_SHA256_ARM64=6287aa46b6c375d816e63ae66d024fbbfd70404825aabdfdf898a970871d2f4b

FROM ${ROCKY_IMAGE} AS node
ARG NODE_VERSION
ARG NODE_SHA256_X64
ARG NODE_SHA256_ARM64
ARG TARGETARCH

# Only the `node` binary goes on to the runtime stage; npm stays here, where
# the build needs it.
RUN microdnf -y install --setopt=install_weak_deps=0 tar xz \
 && microdnf clean all \
 && case "${TARGETARCH:-amd64}" in \
      amd64) arch=x64; sum="${NODE_SHA256_X64}" ;; \
      arm64) arch=arm64; sum="${NODE_SHA256_ARM64}" ;; \
      *) echo "unsupported architecture ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && curl -fsSLo /tmp/node.tar.xz "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${arch}.tar.xz" \
 && echo "${sum}  /tmp/node.tar.xz" | sha256sum -c - \
 && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --no-same-owner \
 && rm /tmp/node.tar.xz \
 && node --version


FROM node AS builder

WORKDIR /app

# Dependencies first, so a source-only change does not re-resolve them.
# `npm ci` and not `npm install`: it installs exactly what package-lock.json
# pins and fails if the lockfile and the manifest disagree, which is the
# property that makes a build reproducible.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Produces .next/standalone — a self-contained server carrying only the modules
# actually reached, run by `node server.js`. Requires `output: "standalone"` in
# next.config.ts.
RUN npm run build


FROM ${ROCKY_IMAGE} AS runtime

# ─── The distribution's security fixes ───
#
# The base is pinned by digest, which also freezes the OS packages it carries.
# They age while the digest does not: on 2026-09-25 Trivy found three HIGH CVEs
# in pcre2 that no dependency lockfile shows. So every build upgrades the OS
# packages (CI builds with --no-cache for this to run); upgrading only the
# offending package would turn the next errata red. The digest stays pinned: it
# is the package layer that floats, not the image.
RUN microdnf -y upgrade \
 && microdnf clean all

RUN groupadd --system app && useradd --system --gid app --home /app app

# The node binary alone: no npm, no npx. The global npm is build tooling, and
# it is what a scanner finds first (tar, sigstore, picomatch, ip-address all
# arrived through it), none of it needed to serve pages. The standalone server
# is started by `node`, never by npm.
COPY --from=node /usr/local/bin/node /usr/local/bin/node

WORKDIR /app
ENV NODE_ENV=production

# The standalone output carries its own minimal node_modules and server.js.
# `static` and `public` are NOT included by Next and must be copied alongside,
# or the app serves pages stripped of every asset — a failure that looks like a
# broken stylesheet rather than a broken build.
COPY --from=builder --chown=app:app /app/.next/standalone ./
COPY --from=builder --chown=app:app /app/.next/static ./.next/static
COPY --from=builder --chown=app:app /app/public ./public

USER app
EXPOSE 3000

# next.config.ts is compiled into the standalone server, so its `rewrites` —
# which proxy /api/* to API_INTERNAL_URL and serve the ghostapp manifest — ship
# with it. The variable is read at runtime.
ENV HOSTNAME=0.0.0.0 PORT=3000
CMD ["node", "server.js"]
